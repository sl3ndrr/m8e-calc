{
  "name": "m8e-calc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build-target.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:engine:bench && npm run test:graph:bench",
    "tokens": "node scripts/generate-tokens.mjs",
    "screenshots:gallery": "node scripts/gallery-screenshots.mjs",
    "test:engine:bench": "node scripts/engine-benchmark.mjs",
    "test:graph:bench": "node scripts/graph-benchmark.mjs",
    "screenshots": "node scripts/release-screenshots.mjs",
    "build:gallery": "tsc -b && vite build --mode gallery && node scripts/check-build-target.mjs dist-gallery gallery",
    "preview:gallery": "vite preview --mode gallery",
    "test:e2e:gallery": "playwright test --config=playwright.gallery.config.ts"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "motion": "^12.23.24",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.7",
    "material-symbols": "^0.39.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8",
    "react-aria-components": "^1.12.1",
    "decimal.js": "^10.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lint": "^6.8.5",
    "@lezer/highlight": "^1.2.1",
    "katex": "^0.18.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.36.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "axe-core": "^4.10.3",
    "@axe-core/playwright": "^4.10.2",
    "@testing-library/user-event": "^14.6.1"
  }
}
