{
  "name": "m8e-calc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:engine:bench",
    "tokens": "node scripts/generate-tokens.mjs",
    "screenshots:gallery": "node scripts/gallery-screenshots.mjs",
    "test:engine:bench": "node scripts/engine-benchmark.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "motion": "^14.1.0",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.7",
    "material-symbols": "^0.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8",
    "react-aria-components": "^1.12.1",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^4.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.2.1",
    "vitest": "^5.0.3",
    "axe-core": "^4.10.3",
    "@axe-core/playwright": "^4.10.2",
    "@testing-library/user-event": "^14.6.1"
  }
}
