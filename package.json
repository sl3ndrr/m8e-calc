{
  "name": "m8e-calc", "version": "0.1.0", "private": true, "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite", "build": "tsc -b && vite build", "preview": "vite preview",
    "lint": "eslint . && prettier --check .", "typecheck": "tsc -b --pretty false",
    "test": "vitest run", "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0", "zustand": "^5.0.8" },
  "devDependencies": {
    "@eslint/js": "^9.36.0", "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0", "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4", "eslint": "^9.36.0", "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0", "fast-check": "^4.3.0", "globals": "^16.4.0",
    "jsdom": "^27.0.0", "prettier": "^3.6.2", "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1", "vite": "^7.1.7", "vitest": "^3.2.4"
  }
}
