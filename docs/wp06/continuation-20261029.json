    "source": "import assert from 'node:assert/strict';\nimport * as current from '../m8e-calc/src/units/index.ts';\nimport * as original from './original/src/units/index.ts';\n\nlet preserved = 0;\nlet newlyAccepted = 0;\nlet stillRejected = 0;\nconst additions = [];\nfor (const locale of ['de', 'en']) {\n  for (const category of current.categories) {\n    for (const unit of category.units) {\n      const terms = new Set([unit.id, unit.symbol, unit.names[locale], ...unit.aliases]);\n      for (const term of terms) {\n        for (const connector of ['in', 'to', 'nach', '->', '→']) {\n          const query = `1 ${term} ${connector} ${category.baseUnitId}`;\n          let before;\n          let beforeError;\n          try { before = original.parseQuery(query, locale); }\n          catch (error) { if (!(error instanceof original.UnitError)) throw error; beforeError = error.code; }\n          let after;\n          try { after = current.parseQuery(query, locale); }\n          catch (error) {\n            if (!(error instanceof current.UnitError)) throw error;\n            assert.equal(before, undefined, `Previously valid query rejected: ${locale}: ${query}: ${error.code}`);\n            stillRejected++;\n            continue;\n          }\n          if (before) {\n            assert.equal(after.fromId, before.fromId, `${locale}: ${query}`);\n            assert.equal(after.toId, before.toId, `${locale}: ${query}`);\n            assert.equal(after.value.toString(), before.value.toString(), `${locale}: ${query}`);\n            preserved++;\n          } else {\n            assert.equal(after.fromId, unit.id, `${locale}: ${query}`);\n            assert.equal(after.toId, category.baseUnitId, `${locale}: ${query}`);\n            assert.equal(current.convert(after.value, after.fromId, after.toId).toString(), current.convert('1', unit.id, category.baseUnitId).toString(), `${locale}: ${query}`);\n            newlyAccepted++;\n            additions.push({locale, query, beforeError, fromId: after.fromId, toId: after.toId});\n          }\n        }\n      }\n    }\n  }\n}\nconsole.log(JSON.stringify({ node: process.version, preserved, newlyAccepted, stillRejected, additions,\n  note: 'Supplemental real-source catalogue differential check; does not replace Vitest or production browser validation.' }, null, 2));\n"
  },
