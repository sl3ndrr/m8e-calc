{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/buildFlags.d.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.ap28.config.ts",
    "playwright.gallery.config.ts",
    "e2e"
  ]
}
